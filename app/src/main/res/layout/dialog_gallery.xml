<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/info_dialog_bg">

    <TextView
        android:id="@+id/dialogGalleryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gallery"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#4F4A57"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- ============ Phase 2: Banner tabs inside Gallery ============ -->
    <!-- Same 3 tabs as the main screen; selecting one filters this  -->
    <!-- dialog AND updates the main screen's active banner so the   -->
    <!-- two stay in sync (single source of truth on currentBannerId)-->
    <LinearLayout
        android:id="@+id/galleryBannerTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bottom_action_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/galleryTabDogs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Doggos"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4F4A57" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="#D8C8EA" />

        <TextView
            android:id="@+id/galleryTabAnime"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Anime"
            android:textSize="13sp"
            android:textColor="#8A7BA3" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="#D8C8EA" />

        <TextView
            android:id="@+id/galleryTabFood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Foodies"
            android:textSize="13sp"
            android:textColor="#8A7BA3" />
    </LinearLayout>

    <TextView
        android:id="@+id/collectionProgressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:text="Collected: 0 / 10"
        android:textColor="#8A7BA3"
        android:textSize="14sp" />

    <!-- RecyclerView is wrap_content so the dialog grows to fit all 10 -->
    <!-- rows of the current banner. With 3 columns and 10 items, that's -->
    <!-- 4 rows (the last row holds the Secret card alone). No scrolling -->
    <!-- needed — the dialog dynamically resizes per banner.             -->
    <!-- nestedScrollingEnabled=false avoids any tug-of-war with potential -->
    <!-- parent scroll containers.                                       -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialogGalleryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp" />

</LinearLayout>