<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F1FA"
    android:padding="0dp">
    <LinearLayout
        android:id="@+id/chanceBadge"
        android:layout_width="136dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/chance_badge_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/chanceIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/chance_ticket_icon"
            android:contentDescription="Chance Icon" />

        <TextView
            android:id="@+id/chanceCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="10"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4F4A57" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/infoBadge"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/chance_badge_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/infoIconText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#6B5BBE" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Info"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4F4A57" />
    </LinearLayout>
    <ImageView
        android:id="@+id/gachaMachineImage"
        android:layout_width="1050dp"
        android:layout_height="900dp"
        android:layout_marginTop="50dp"
        android:contentDescription="Gacha Machine"
        android:scaleType="fitCenter"
        android:src="@drawable/gacha_machine_main"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/starButton"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/star_button"
        android:contentDescription="Pull Button"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@id/gachaMachineImage"
        app:layout_constraintStart_toStartOf="@id/gachaMachineImage"
        app:layout_constraintEnd_toEndOf="@id/gachaMachineImage"
        android:layout_marginBottom="120dp" />
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bottom_action_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/getChancesButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Get Chances"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4F4A57" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#D8C8EA" />

        <TextView
            android:id="@+id/galleryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Gallery"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4F4A57" />
    </LinearLayout>
    <View
        android:id="@+id/cardSpawnAnchor"
        android:layout_width="40dp"
        android:layout_height="20dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="@id/gachaMachineImage"
        app:layout_constraintBottom_toBottomOf="@id/gachaMachineImage"
        app:layout_constraintStart_toStartOf="@id/gachaMachineImage"
        app:layout_constraintEnd_toEndOf="@id/gachaMachineImage"
        android:translationY="250dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:visibility="invisible"
        app:cardCornerRadius="18dp"
        app:strokeWidth="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/cardBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/card_back" />

            <ImageView
                android:id="@+id/cardFront"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>